# Build output and downloaded dependencies. Everything here is reproducible
# from the sources that are tracked, so it never belongs in the repository or
# in a submission archive.
target/
frontend/node_modules/
frontend/dist/
__pycache__/

# Local editor and agent tooling. Useful on one machine, meaningless in the
# repository, and identifying in a blind review.
.vscode/
.tools/
.claude/
.idea/

# Course handouts and private planning notes that are not part of the delivered
# system.
OOP - Group Project.pdf
AGENTS.md
project.md

# The generated submission package and its staging directory.
submission/

# Generated simulation output. Regenerate rather than commit: a trace is
# reproducible from its map, scenario and seed, so it adds weight without
# adding information. The routing baseline is the one exception.
data/results/*
!data/results/experiment_results.json

# Downloaded artwork archives. The extracted PNGs belong in the repo; the zips
# they arrived in do not.
frontend/public/assets/**/*.zip

# Standalone project walkthrough, generated by tools/build_presentation.mjs.
PRESENTATION.html

# Contribution report material for the write-up. Both name real people, which is
# exactly what the blind-review copy must not contain, so they stay out of the
# repository and therefore out of the submission package.
COMMIT_REPORT.md
COMMIT_HISTORY.csv
